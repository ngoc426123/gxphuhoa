#gx-footer
  #footerMain
    .wrapper
      .footerGrid
        //- Col 1: Brand
        .footerCol.footerCol--brand
          a.footerBrand(href="index.html" title="Giáo Xứ Phú Hòa")
            img(src="images/logo.png" alt="Giáo Xứ Phú Hòa")
            .footerBrand-name
              span.footerBrand-top Giáo Xứ
              span.footerBrand-bot PHÚ HOÀ
          p.footerTagline Ban truyền thông Giáo xứ Phú Hòa – Giáo hạt Tân Sơn Nhì, Tổng Giáo phận TP.HCM.
          .footerSocialLinks
            a.footerSocialLinks-item(href="#" title="Facebook" aria-label="Facebook")
              i.fab.fa-facebook-f
            a.footerSocialLinks-item(href="#" title="Youtube" aria-label="Youtube")
              i.fab.fa-youtube
            a.footerSocialLinks-item(href="#" title="Twitter" aria-label="Twitter")
              i.fab.fa-twitter
            a.footerSocialLinks-item(href="#" title="Google" aria-label="Google")
              i.fab.fa-google

        //- Col 2: Sitemap
        .footerCol
          h4.footerCol-title Điều hướng
          ul.footerLinks
            li: a(href="index.html") Trang chủ
            li: a(href="about.html") Giới thiệu
            li: a(href="category.html") Thư viện ảnh
            li: a(href="category.html") Lưu trữ
            li: a(href="contact.html") Liên hệ

        //- Col 3: Contact
        .footerCol
          h4.footerCol-title Liên hệ
          .footerAddress
            .footerAddress-row
              i.fas.fa-map-marker-alt
              span 19/2 Hoàng Xuân Nhị, P. Phú Trung, Q. Tân Phú, TP. HCM
            .footerAddress-row
              i.fas.fa-envelope
              a(href="mailto:mvttgxphuhoa@gmail.com") mvttgxphuhoa@gmail.com
            .footerAddress-row
              i.fas.fa-globe
              a(href="http://gxphuhoa.org") gxphuhoa.org

        //- Col 4: Hotline
        .footerCol
          h4.footerCol-title Hỗ trợ
          .footerHotline
            .footerHotline-group
              span.footerHotline-label Hỗ trợ nội dung
              a.footerHotline-num(href="tel:0903378512")
                i.fas.fa-phone-alt
                span 090.337.8512
            .footerHotline-group
              span.footerHotline-label Hỗ trợ hình ảnh
              a.footerHotline-num(href="tel:0903378512")
                i.fas.fa-phone-alt
                span 090.337.8512
            .footerHotline-group
              span.footerHotline-label Hỗ trợ kỹ thuật
              a.footerHotline-num(href="tel:0373996947")
                i.fas.fa-phone-alt
                span 0373.996.947

  #footerBot
    .wrapper
      .footerBottom
        span © 2024 Giáo Xứ Phú Hoà. All rights reserved.
        span Ban truyền thông
          a(href="http://gxphuhoa.org")  Giáo Xứ Phú Hoà

