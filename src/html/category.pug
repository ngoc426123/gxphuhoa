extends _layout/_layout

block main-content
  .row
    .col-12.col-lg-9
      .catPage

        //- ── Header ─────────────────────────────────────────
        .catPage-header
          nav.catPage-breadcrumb
            a(href="index.html") Trang chủ
            i.fas.fa-chevron-right
            span Khu Giáo II Thánh Giuse
          h1.catPage-title
            i.fas.fa-bookmark
            | Khu Giáo II Thánh Giuse
          span.catPage-count 128 bài viết

        //- ── Hero: 1 nổi bật + 3 nhỏ bên phải ─────────────
        .catPage-hero
          .catPage-hero-main
            +newsCard({
              img: 'https://gxphuhoa.org/wp-content/uploads/2014/12/Thanh-gia-508x352.jpg',
              cat: 'Khu Giáo II',
              title: 'THÁNH LỄ KÍNH THÁNH GIUSE : MỪNG BỔN MẠNG GIÁO KHU II',
              des: 'Trong tâm tình cảm tạ hồng ân Chúa, hòa chung với bầu khí Giáo hội hân hoan mừng kính trọng thể Thánh Giuse bạn trăm năm Đức Maria.',
              date: '06:02 19/03/2021',
              link: 'single.html'
            })
          .catPage-hero-side
            +newsCard({
              img: 'https://gxphuhoa.org/wp-content/uploads/2020/03/Le-thanh-Giuse-BM-Kg2-529x352.jpeg',
              cat: 'Khu Giáo II',
              title: 'LỄ KÍNH THÁNH GIUSE BỔN MẠNG GIÁO KHU II',
              date: '17:24 09/05/2021',
              link: 'single.html'
            })
            +newsCard({
              img: 'https://gxphuhoa.org/wp-content/uploads/2020/03/Thanh-Giuse-Copy.jpg',
              cat: 'Thông Báo',
              title: 'THÔNG BÁO: THÁNH LỄ KÍNH THÁNH GIUSE BỔN MẠNG GIÁO KHU 2',
              date: '17:24 09/05/2021',
              link: 'single.html'
            })
            +newsCard({
              img: 'https://gxphuhoa.org/wp-content/uploads/2019/11/KG2-hanh-huong-2019-570x321.jpeg',
              cat: 'Khu Giáo II',
              title: 'Giáo Khu Thánh Giuse: Hành Hương Đức Mẹ Bãi Dâu',
              date: '17:24 09/05/2021',
              link: 'single.html'
            })
            +newsCard({
              img: 'https://gxphuhoa.org/wp-content/uploads/2020/11/Chau-Thanh-The-20-mau-Copy-2.jpg',
              cat: 'Khu Giáo II',
              title: 'Chầu Thánh Thể: Sống Kết Hiệp Với Chúa',
              date: '17:24 09/05/2021',
              link: 'single.html'
            })
            +newsCard({
              img: 'https://gxphuhoa.org/wp-content/uploads/2021/01/Banner-1-Le-Thanh-Phaolo-Tong-do-Tro-Lai-1-570x321.jpg',
              cat: 'Thông Báo',
              title: 'Thông Báo: Lịch Sinh Hoạt Giáo Khu Tháng 3/2021',
              date: '17:24 09/05/2021',
              link: 'single.html'
            })

        //- ── Divider ────────────────────────────────────────
        .catPage-divider
          span Bài viết mới nhất

        //- ── Article list ───────────────────────────────────
        .catPage-list(data-list-news)
          .catNewsRow
            a.catNewsRow-img(href="single.html" title="Audio Thánh Lễ")
              img(src="https://gxphuhoa.org/wp-content/uploads/2020/11/Chau-Thanh-The-20-mau-Copy-2.jpg" alt="Audio Thánh Lễ")
            .catNewsRow-body
              .catNewsRow-meta
                span.catNewsRow-cat Khu Giáo II
                span.catNewsRow-date
                  i.far.fa-clock
                  |  17:24 09/05/2021
              a.catNewsRow-title(href="single.html") [AUDIO THÁNH LỄ] CHÚA NHẬT VI PS-B CHỦ ĐỀ HÃY YÊU THƯƠNG NHAU THÁNH LỄ THIẾU NHI
              p.catNewsRow-des Trong tâm tình cảm tạ hồng ân Chúa, hòa chung với bầu khí Giáo hội hân hoan mừng kính trọng thể Thánh Giuse bạn trăm năm Đức Maria.
