extends _layout/_layout

block main-content
  .contactPage
    .contactPage-map
      iframe(src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3919.450407767398!2d106.6431533148018!3d10.776774062134153!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x31752ebbeb104883%3A0xbc67f7512a83dc9b!2zR2nDoW8gWOG7qSBQaMO6IEjDsmE!5e0!3m2!1svi!2s!4v1506331367780" frameborder="0" width="100%" height="380" allowfullscreen loading="lazy")

    .contactPage-body
      .contactPage-info
        .contactPage-info-header
          h2.contactPage-info-name Ban truyền thông giáo xứ Phú Hòa
        .contactPage-info-items
          .contactPage-info-item
            i.contactPage-info-icon.fa-solid.fa-location-dot
            .contactPage-info-text 19/2 Hoàng Xuân Nhị, P. Phú Trung, Q. Tân Phú, Tp. HCM
          .contactPage-info-item
            i.contactPage-info-icon.fa-solid.fa-envelope
            .contactPage-info-text
              a(href='mailto:mvttgxphuhoa@gmail.com') mvttgxphuhoa@gmail.com
          .contactPage-info-item
            i.contactPage-info-icon.fa-solid.fa-phone
            .contactPage-info-text
              a(href='tel:0373996947') 0373.996.947
          .contactPage-info-item
            i.contactPage-info-icon.fa-solid.fa-globe
            .contactPage-info-text
              a(href='http://gxphuhoa.org') gxphuhoa.org
        .contactPage-info-qr
          +img('https://chart.apis.google.com/chart?cht=qr&chs=300x300&chl=Gi%C3%A1o%20X%E1%BB%A9%20Ph%C3%BA%20h%C3%B2a%0A%C4%90%E1%BB%8Ba%20ch%E1%BB%89%20%3A%2019%2F2%20Ho%C3%A0ng%20Xu%C3%A2n%20Nh%E1%BB%8B%2C%20P.%20Ph%C3%BA%20Trung%2C%20Q.%20T%C3%A2n%20Ph%C3%BA%2C%20Tp.%20HCM%0AEmail%20%3A%20mvttgxphuhoa%40gmail.com%0ASDT%20%3A%2001673.996.947%0AWebsite%20%3A%20http%3A%2F%2Fgxphuhoa.org&choe=UTF-8&chld=H', 'QRcode giáo xứ phú hoà')
          p Quét QR để lưu thông tin

      .contactPage-form
        .contactPage-form-intro
          h3.contactPage-form-title Gửi lời nhắn
          p Quý vị đóng góp ý kiến, hoặc cần giải đáp về giáo lý. Xin vui lòng hoàn tất biểu mẫu dưới đây để chúng tôi có thể trả lời thư của quý vị. Xin cảm ơn!
        form.contactPage-form-body(action='https://gxphuhoa.org/lien-he/' method='post')
          small.text-success
          .contactPage-form-row
            .contactPage-form-group
              label(for='contact-name') Họ tên
              input#contact-name(name='contact-name' type='text' placeholder='Họ tên...')
            .contactPage-form-group
              label(for='contact-address') Địa chỉ
              input#contact-address(name='contact-address' type='text' placeholder='Địa chỉ...')
          .contactPage-form-row
            .contactPage-form-group
              label(for='contact-email') Email
              input#contact-email(name='contact-email' type='email' placeholder='Email...')
            .contactPage-form-group
              label(for='contact-gx') Giáo xứ
              input#contact-gx(name='contact-gx' type='text' placeholder='Giáo xứ...')
          .contactPage-form-group
            label(for='contact-content') Nội dung
            textarea#contact-content(name='contact-content' placeholder='Nội dung...')
          .contactPage-form-group
            label Mã bảo vệ
            .contactPage-form-captcha
              input(name='ser' type='text' placeholder='Nhập mã...')
              img(src='https://gxphuhoa.org/wp-content/themes/maintheme/captcha.php' alt='Captcha')
            small.text-danger
          .contactPage-form-submit
            button(type='submit' name='ok')
              i.fa-solid.fa-paper-plane
              span Gửi tin nhắn