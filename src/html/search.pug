extends _layout/_layout

block main-content
  .row
    .col-12.col-lg-9
      .searchPage

        //- ── Header ─────────────────────────────────────────
        .searchPage-header
          nav.catPage-breadcrumb
            a(href="index.html") Trang chủ
            i.fas.fa-chevron-right
            span Kết quả tìm kiếm
          h1.searchPage-title
            i.fas.fa-search
            | Kết quả tìm kiếm
          .searchPage-meta
            span.searchPage-keyword
              | Từ khoá:&nbsp;
              strong "phúc âm"
            span.searchPage-count 12 kết quả

        //- ── Search bar refine ───────────────────────────────
        form.searchPage-form(action="search.html" method="get")
          input.searchPage-form__input(
            type="search"
            name="s"
            value="phúc âm"
            placeholder="Tìm kiếm lại..."
          )
          button.searchPage-form__btn(type="submit")
            i.fas.fa-search
            | &nbsp;Tìm kiếm

        //- ── Divider ────────────────────────────────────────
        .catPage-divider
          span 12 bài viết phù hợp

        //- ── Results list ────────────────────────────────────
        .searchPage-list
          .catNewsRow
            a.catNewsRow-img(href="single.html" title="Cầu nguyện với Phúc Âm")
              img(src="https://gxphuhoa.org/wp-content/uploads/2020/08/cau-nguyen-voi-phuc-am-2-469x352.jpg" alt="Cầu nguyện với Phúc Âm")
            .catNewsRow-body
              .catNewsRow-meta
                span.catNewsRow-cat Suy Niệm
                span.catNewsRow-date
                  i.far.fa-clock
                  |  06:00 15/08/2020
              a.catNewsRow-title(href="single.html") Cầu nguyện với Phúc Âm – Thứ Bảy Tuần 6 Phục Sinh B
              p.catNewsRow-des Trong tâm tình cảm tạ hồng ân Chúa, hòa chung với bầu khí Giáo hội hân hoan qua những trang Phúc Âm đong đầy ánh sáng và tình yêu thương.
              .searchPage-excerpt
                | ...những trang&nbsp;
                mark phúc âm
                | &nbsp;đong đầy ánh sáng và tình yêu thương của Thiên Chúa...

          .catNewsRow
            a.catNewsRow-img(href="single.html" title="Lectio Divina")
              img(src="https://gxphuhoa.org/wp-content/uploads/2020/08/cau-nguyen-voi-phuc-am-2-469x352.jpg" alt="Lectio Divina")
            .catNewsRow-body
              .catNewsRow-meta
                span.catNewsRow-cat Suy Niệm
                span.catNewsRow-date
                  i.far.fa-clock
                  |  09:00 22/05/2021
              a.catNewsRow-title(href="single.html") Lectio Divina – Đọc và Suy Niệm Phúc Âm Chúa Nhật
              p.catNewsRow-des Phương pháp đọc Kinh Thánh cổ điển giúp tâm hồn lắng đọng và gặp gỡ Thiên Chúa qua từng trang Phúc Âm.
              .searchPage-excerpt
                | ...gặp gỡ Thiên Chúa qua từng trang&nbsp;
                mark phúc âm
                | &nbsp;Thánh Gioan...

          .catNewsRow
            a.catNewsRow-img(href="single.html" title="Phúc Âm Chúa Nhật")
              img(src="https://gxphuhoa.org/wp-content/uploads/2021/05/BMGx-va-Hdmv-Phu-Hoa-01-05-2021-14-570x320.jpg" alt="Phúc Âm Chúa Nhật")
            .catNewsRow-body
              .catNewsRow-meta
                span.catNewsRow-cat Tin Giáo Xứ
                span.catNewsRow-date
                  i.far.fa-clock
                  |  06:00 01/05/2021
              a.catNewsRow-title(href="single.html") Bài Giảng Phúc Âm Chúa Nhật – Mừng Bổn Mạng Thánh Giuse
              p.catNewsRow-des Bài giảng trong thánh lễ mừng bổn mạng giáo xứ xoay quanh đoạn Phúc Âm về sự vâng phục và phó thác của Thánh Giuse.
              .searchPage-excerpt
                | ...đoạn&nbsp;
                mark phúc âm
                | &nbsp;về sự vâng phục và phó thác...

          .catNewsRow
            a.catNewsRow-img(href="single.html" title="Suy niệm lời Chúa")
              img(src="https://gxphuhoa.org/wp-content/uploads/2020/11/Chau-Thanh-The-20-mau-Copy-2.jpg" alt="Suy niệm lời Chúa")
            .catNewsRow-body
              .catNewsRow-meta
                span.catNewsRow-cat Suy Niệm
                span.catNewsRow-date
                  i.far.fa-clock
                  |  17:00 09/05/2021
              a.catNewsRow-title(href="single.html") Suy Niệm Lời Chúa – Chúa Nhật VI Phục Sinh B
              p.catNewsRow-des Đoạn trích Phúc Âm hôm nay mời gọi mỗi người Kitô hữu sống yêu thương như Chúa Giêsu đã yêu thương.
              .searchPage-excerpt
                | ...đoạn trích&nbsp;
                mark phúc âm
                | &nbsp;hôm nay mời gọi mỗi người...

          .catNewsRow
            a.catNewsRow-img(href="single.html" title="Kinh Thánh")
              img(src="https://gxphuhoa.org/wp-content/uploads/2020/03/Le-thanh-Giuse-BM-Kg2-529x352.jpeg" alt="Kinh Thánh")
            .catNewsRow-body
              .catNewsRow-meta
                span.catNewsRow-cat Giáo Lý
                span.catNewsRow-date
                  i.far.fa-clock
                  |  08:30 14/03/2021
              a.catNewsRow-title(href="single.html") Hướng Dẫn Đọc Kinh Thánh – Từ Phúc Âm Đến Thư Thánh Phaolô
              p.catNewsRow-des Chuỗi bài giáo lý giúp giáo dân hiểu rõ hơn cấu trúc Kinh Thánh, bắt đầu từ bốn Phúc Âm nhất lãm.
              .searchPage-excerpt
                | ...bắt đầu từ bốn&nbsp;
                mark phúc âm
                | &nbsp;nhất lãm của Tân Ước...

        //- ── No results (hidden by default, show via JS/server) ──
        //-  .searchPage-empty
        //-   i.fas.fa-search
        //-   p Không tìm thấy kết quả nào cho từ khoá này.
        //-   span Hãy thử từ khoá khác hoặc kiểm tra chính tả.

        //- ── Pagination ──────────────────────────────────────
        .catPage-more
          button.catPage-more-btn(type="button")
            | Xem thêm kết quả
            i.fas.fa-chevron-down

    .col-12.col-lg-3
      include ./_components/_sidebar.pug
