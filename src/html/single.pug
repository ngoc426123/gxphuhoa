extends _layout/_layout

block main-content
  .the-single(data-single)

    //- Breadcrumb
    nav.the-breadcrumb
      a(href="index.html") Trang chủ
      i.fas.fa-angle-right
      a(href="category.html") Khu Giáo II Thánh Giuse
      i.fas.fa-angle-right
      span Thánh lễ kính Thánh Giuse & Mừng bổn mạng Giáo khu II

    .row
      .col-12.col-lg-9
        //- Article header
        header.the-article-head
          span.the-article-cat Khu Giáo II Thánh Giuse
          h1.the-article-title THÁNH LỄ KÍNH THÁNH GIUSE : MỪNG BỔN MẠNG GIÁO KHU II
          .the-article-meta
            span.the-article-meta-item
              i.far.fa-calendar-alt
              | &nbsp;Thứ Sáu, 19/03/2021
            span.the-article-meta-item
              i.far.fa-clock
              | &nbsp;17:24
            span.the-article-meta-item
              i.far.fa-user
              | &nbsp;Ban Truyền Thông

        //- Featured image
        .the-article-thumb
          +img('https://gxphuhoa.org/wp-content/uploads/2014/12/Thanh-gia.jpg', 'Thánh lễ kính Thánh Giuse - Mừng bổn mạng Giáo khu II')

        //- Body content
        .the-content.ck-content
          p Thinh lặng lắng nghe tiếng gọi của Thiên Chúa, Thánh Giuse đã âm thầm đi sâu vào đời sống nội tâm. Ngài hiểu tiếng gọi đó là một tình thương đặc biệt. Ngài trả lời như một giao ước, một gắn bó tín trung bền vững. Chúa gọi và chỉ dẫn ở từng chặng đường, Ngài nghe và vâng theo rồi mau mắn thi hành. Cho dù gặp khó khăn trắc trở, ngài luôn vững tin ở Đấng đã gọi mình.
          p Hôm nay Giáo hội Công giáo mừng kính Thánh Giuse Bạn Đức Maria.
          p Hòa chung với Giáo hội hoàn vũ, cộng đoàn Giáo xứ hân hoan mừng kính Thánh Giuse và đặc biệt chúc mừng bổn mạng cộng đoàn Giáo khu 2.
          p Kính mời quý cộng đoàn dân Chúa tham dự thánh lễ tạ ơn. Lúc 17g30 thứ Sáu ngày 19-03-2021 tại Nhà thờ Giáo xứ Phú Hòa.

        //- Prev / Next navigation
        nav.the-article-nav
          a.the-article-nav-item.the-article-nav-prev(href="single.html")
            .the-article-nav-thumb
              img(src="https://gxphuhoa.org/wp-content/uploads/2019/11/KG2-hanh-huong-2019.jpeg" alt="Giáo Khu Thánh Giuse: Hành Hương Đức Mẹ Bãi Dâu")
            .the-article-nav-body
              span.the-article-nav-label
                i.fas.fa-arrow-left
                |  Bài trước
              span.the-article-nav-title Giáo Khu Thánh Giuse: Hành Hương Đức Mẹ Bãi Dâu
          a.the-article-nav-item.the-article-nav-next(href="single.html")
            .the-article-nav-body
              span.the-article-nav-label
                | Bài sau 
                i.fas.fa-arrow-right
              span.the-article-nav-title THÔNG BÁO: Thánh lễ kính Thánh Đaminh Savio bổn mạng Ban Lễ Sinh
            .the-article-nav-thumb
              img(src="https://gxphuhoa.org/wp-content/uploads/2020/05/Thanh-Daminh-Savio.jpg" alt="THÔNG BÁO: Thánh lễ kính Thánh Đaminh Savio bổn mạng Ban Lễ Sinh")

        //- Related articles
        .the-related
          .the-related-head
            span.the-related-title Bài viết liên quan
          .the-related-grid
            +newsCard({
              img: 'https://gxphuhoa.org/wp-content/uploads/2020/03/Le-thanh-Giuse-BM-Kg2.jpeg',
              cat: 'Khu Giáo II',
              title: 'LỄ KÍNH THÁNH GIUSE BỔN MẠNG GIÁO KHU II',
              des: 'Trong tâm tình cảm tạ hồng ân Chúa, hòa chung với bầu khí Giáo hội hân hoan mừng kính Thánh Giuse.',
              date: '17:24 09/05/2021',
              link: 'single.html'
            })
            +newsCard({
              img: 'https://gxphuhoa.org/wp-content/uploads/2020/03/Thanh-Giuse-Copy.jpg',
              cat: 'Thông Báo',
              title: 'THÔNG BÁO: THÁNH LỄ KÍNH THÁNH GIUSE BỔN MẠNG GIÁO KHU 2',
              des: 'Kính mời quý cộng đoàn dân Chúa tham dự thánh lễ tạ ơn mừng kính Thánh Giuse bổn mạng Giáo khu.',
              date: '17:24 09/05/2021',
              link: 'single.html'
            })
            +newsCard({
              img: 'https://gxphuhoa.org/wp-content/uploads/2019/11/KG2-hanh-huong-2019.jpeg',
              cat: 'Khu Giáo II',
              title: 'Giáo Khu Thánh Giuse: Hành Hương Đức Mẹ Bãi Dâu',
              des: 'Trong tinh thần hiệp nhất và cầu nguyện, cộng đoàn Giáo khu II tổ chức hành hương kính Đức Mẹ.',
              date: '17:24 09/05/2021',
              link: 'single.html'
            })

      .col-12.col-lg-3
        include ./_components/_sidebarsingle.pug

    .single-fixed(data-single-fixed)
      .wrapper
        .left
          .lg.d-none.d-lg-block
            +img('https://gxphuhoa.org/wp-content/themes/maintheme/images/logo.png', 'Logo Giáo Xứ Phú Hoà')
          .cat.d-none.d-lg-block Khu Giáo II Thánh Giuse
          .title Giáo Khu Thánh Giuse: Hành Hương Đức Mẹ Bãi Dâu
        +social()
            